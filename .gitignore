# ── 构建产物 ─────────────────────────────────
[Bb]in/
[Oo]bj/
*.user
*.suo
.vs/
*.wpftmp.*
# 自定义 BaseOutputPath 输出目录（/build/、以及路径分隔符被 shell 吃掉后产生的 traetoolbuild* 目录）
/build/
/traetoolbuild*/
/TraeTool/traetoolbuild*/

# ── 本地截图（含真实 UID/手机号，禁止入库）──────
/ui-*.png
/exe-icon-check.png
/屏幕截图*.png

# ── 更新源测试物料（14MB，仅本地自检用）─────────
/_updatefeed/

# ── 发版产物（zip 由 tools 打包，不入库）─────────
/dist/

# ── 设计说明与原型（仅本地，不入库）───────────────
/docs/

# ── 运行期数据与日志（实际落在 %APPDATA%，双保险）─
*.log
*.db
*.db-wal
*.db-shm

# ── 编辑器 / 系统 ────────────────────────────────
.idea/
.vscode/
Thumbs.db
Desktop.ini
