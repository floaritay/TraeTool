<UserControl x:Class="TraeTool.Views.ProxyPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TraeTool.Views"
             xmlns:icons="clr-namespace:TraeTool.Resources"
             Background="{DynamicResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <DockPanel Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="出站代理" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="只约束本工具自身的网络请求 · 即时生效" Style="{StaticResource PageMeta}"/>
                </StackPanel>
            </DockPanel>

            <!-- 状态横幅：复制 Token 等操作的即时回执 -->
            <Border Style="{StaticResource BannerInfo}" Margin="0,0,0,12"
                    Visibility="{Binding StatusMessage, Converter={x:Static views:NonEmptyConverter.Instance}}">
                <DockPanel>
                    <Path DockPanel.Dock="Left" Data="{x:Static icons:Icons.Info}" Style="{StaticResource Ico}"
                          Width="14" Height="14" Stroke="{DynamicResource PrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5"
                               Foreground="{DynamicResource PrimaryStrongBrush}" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- 出站代理（仅约束本工具自身请求，即时生效） -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="即时生效" Style="{StaticResource CardMeta}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="出站代理" Style="{StaticResource CardTitle}" Margin="0"/>
                    </DockPanel>
                    <TextBlock FontSize="11" Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap"
                               Margin="0,0,0,10"
                               Text="只约束本工具自身的网络请求（签到、状态查询、更新下载、WebView2 登录页），不拦截其他软件的流量。"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton GroupName="proxy" Content="跟随系统" FontSize="12.5"
                                     Foreground="{DynamicResource TextBrush}"
                                     IsChecked="{Binding ProxyIsSystem}"
                                     VerticalAlignment="Center"/>
                        <RadioButton GroupName="proxy" Content="不使用代理" FontSize="12.5"
                                     Foreground="{DynamicResource TextBrush}"
                                     IsChecked="{Binding ProxyIsNone}"
                                     Margin="22,0,0,0" VerticalAlignment="Center"/>
                        <RadioButton GroupName="proxy" Content="手动指定" FontSize="12.5"
                                     Foreground="{DynamicResource TextBrush}"
                                     IsChecked="{Binding ProxyIsManual}"
                                     Margin="22,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="代理地址" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding ProxyUrl, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding ProxyIsManual}"
                             ToolTip="如 http://127.0.0.1:7890 或 socks5://127.0.0.1:1080；漏写协议按 http:// 处理"/>
                    <TextBlock FontSize="10.5" Foreground="{DynamicResource MuteBrush}" TextWrapping="Wrap"
                               Margin="2,5,0,0"
                               Text="仅在「手动指定」时生效；127.0.0.1 的本机地址不走代理。系统未设代理时「跟随系统」等同直连。"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="测试连通"
                                Command="{Binding TestProxyCommand}"
                                IsEnabled="{Binding Busy, Converter={x:Static views:InvertBoolConverter.Instance}}"/>
                        <TextBlock Text="{Binding ProxyStatus}" FontSize="11" Margin="12,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
