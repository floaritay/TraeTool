<Window x:Class="TraeTool.Views.EulaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:TraeTool.Resources"
        Title="用户协议与免责声明"
        Width="600" SizeToContent="Height" MaxHeight="640"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource FontBody}" FontSize="12.5">
    <Grid Margin="14">
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="22,20"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#121820" BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.18"/>
            </Border.Effect>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Width="34" Height="34" CornerRadius="10"
                            Background="{DynamicResource PrimarySoftBrush}" Margin="0,0,12,0">
                        <Path Data="{x:Static icons:Icons.Shield}" Style="{StaticResource Ico}"
                              Width="17" Height="17" Stroke="{DynamicResource PrimaryBrush}"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="用户协议与免责声明" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="首次启动时确认 · 同意后进入主界面" FontSize="10.5"
                                   Foreground="{DynamicResource MuteBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Background="{DynamicResource Surface2Brush}" CornerRadius="9"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        Padding="14,12" MaxHeight="360">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SubBrush}"
                                       TextWrapping="Wrap" LineHeight="20"
                                       Text="欢迎使用 TraeTool。本工具是纯本地的效率程序：多账号签到、数据看板、用量统计与客户端登录态切换全部在你的电脑上完成。"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SubBrush}"
                                       TextWrapping="Wrap" LineHeight="20" Margin="0,8,0,0"
                                       Text="· 账号凭据以 Windows DPAPI 加密保存，仅当前 Windows 用户可解密，不会上传到任何服务器。"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SubBrush}"
                                       TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0"
                                       Text="· 使用自动签到、账号切换等功能时，请遵守 Trae 服务条款，风险自负。"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SubBrush}"
                                       TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0"
                                       Text="· 本工具为个人开源效率软件，与 ByteDance / TRAE 官方无任何关系。"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource SubBrush}"
                                       TextWrapping="Wrap" LineHeight="20" Margin="0,4,0,0"
                                       Text="· 账号数据仅存于本机 %APPDATA%\TraeTool\ 目录；请勿将配置文件分享或提交到公开仓库。"/>
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextBrush}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0"
                                       Text="点击「同意并继续」表示你已阅读并接受以上内容；拒绝将退出程序。"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="BtnDecline" Style="{StaticResource GhostButton}" MinWidth="88"
                            Content="拒绝并退出" Click="OnDeclineClick"/>
                    <Button x:Name="BtnAccept" Style="{StaticResource AccentButton}" MinWidth="104"
                            Margin="10,0,0,0" Content="同意并继续" Click="OnAcceptClick"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
