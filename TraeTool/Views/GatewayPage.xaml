<UserControl x:Class="TraeTool.Views.GatewayPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TraeTool.Views"
             xmlns:icons="clr-namespace:TraeTool.Resources"
             Background="{DynamicResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <DockPanel Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="本机网关" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="回环地址 HTTP 接口 · 账号池对话转发 · 模型列表" Style="{StaticResource PageMeta}"/>
                </StackPanel>
            </DockPanel>

            <!-- 状态横幅：复制 Token 等操作的即时回执 -->
            <Border Style="{StaticResource BannerInfo}" Margin="0,0,0,12"
                    Visibility="{Binding StatusMessage, Converter={x:Static views:NonEmptyConverter.Instance}}">
                <DockPanel>
                    <Path DockPanel.Dock="Left" Data="{x:Static icons:Icons.Info}" Style="{StaticResource Ico}"
                          Width="14" Height="14" Stroke="{DynamicResource PrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5"
                               Foreground="{DynamicResource PrimaryStrongBrush}" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- 本机管理网关（只读状态查询 + 触发签到） -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="只监听 127.0.0.1" Style="{StaticResource CardMeta}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="本机管理网关" Style="{StaticResource CardTitle}" Margin="0"/>
                    </DockPanel>
                    <TextBlock FontSize="11" Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap"
                               Margin="0,0,0,10"
                               Text="在本机开一个只读 HTTP 接口，供脚本/面板读取账号健康与今日签到状态、或远程触发批量签到。不代理任何第三方流量。"/>

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding GatewayEnabled}"
                              Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="启用本机管理网关" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="开启后随本程序启动与退出；除 /healthz 外的接口都要携带令牌。"
                                       FontSize="10" Foreground="{DynamicResource MuteBrush}"
                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Text="{Binding GatewayStatus}" FontSize="10.5"
                               Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap"
                               Margin="2,0,0,12"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="监听端口" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0"/>
                        <TextBox Grid.Column="1" Style="{StaticResource Input}"
                                 Text="{Binding GatewayPortText, UpdateSourceTrigger=LostFocus}"
                                 ToolTip="留空使用默认端口；修改后在启用状态会立即重启监听"/>
                        <TextBox Grid.Column="2" Style="{StaticResource Input}"
                                 Text="{Binding GatewayEndpoint, Mode=OneWay}"
                                 IsReadOnly="True" FontSize="11" FontFamily="{StaticResource FontMono}"
                                 Margin="12,0,0,0" VerticalContentAlignment="Center"
                                 ToolTip="可直接选中复制"/>
                        <Button Grid.Column="3" Style="{StaticResource GhostButton}" Padding="10,4"
                                FontSize="11" Content="复制"
                                Command="{Binding CopyTextCommand}"
                                CommandParameter="{Binding GatewayEndpoint}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="访问令牌" Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center" Margin="0"/>
                        <TextBlock Grid.Column="1" Text="{Binding GatewayTokenMasked}" FontSize="11"
                                   FontFamily="{StaticResource FontMono}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="10,4"
                                FontSize="11" Content="复制"
                                Command="{Binding CopyGatewayTokenCommand}"/>
                    </Grid>

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding GatewayChatEnabled}"
                              IsEnabled="{Binding GatewayEnabled}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="启用 OpenAI 兼容对话转发（/v1/*）" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="在启用、已登录、未暂停的账号间轮询取号调用上游；凭据失效的账号自动冷却，池内无可用账号时返回 503。"
                                       FontSize="10" Foreground="{DynamicResource MuteBrush}"
                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Text="OpenAI base URL" Style="{StaticResource FieldLabel}" Margin="0"/>
                    <DockPanel Margin="2,4,0,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="10,4"
                                FontSize="11" Content="复制"
                                Command="{Binding CopyTextCommand}"
                                CommandParameter="{Binding GatewayOpenAiUrl}"/>
                        <TextBox Style="{StaticResource Input}"
                                 Text="{Binding GatewayOpenAiUrl, Mode=OneWay}"
                                 IsReadOnly="True" FontSize="10.5" FontFamily="{StaticResource FontMono}"
                                 ToolTip="可直接选中复制；Bearer 填上面的访问令牌"/>
                    </DockPanel>

                    <TextBlock Text="调用示例" Style="{StaticResource FieldLabel}" Margin="0"/>
                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="10.5"
                               Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" Margin="2,4,0,0"
                               Text="curl http://127.0.0.1:8766/status -H &quot;X-TraeTool-Token: &lt;令牌&gt;&quot;"/>
                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="10.5"
                               Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" Margin="2,2,0,0"
                               Text="curl -X POST http://127.0.0.1:8766/checkin -H &quot;X-TraeTool-Token: &lt;令牌&gt;&quot;"/>
                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="10.5"
                               Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" Margin="2,2,0,0"
                               Text="curl http://127.0.0.1:8766/v1/models -H &quot;Authorization: Bearer &lt;令牌&gt;&quot;"/>
                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="10.5"
                               Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" Margin="2,2,0,0"
                               Text="curl http://127.0.0.1:8766/v1/messages -H &quot;x-api-key: &lt;令牌&gt;&quot; -d '{&quot;model&quot;:&quot;trae&quot;,&quot;max_tokens&quot;:64,&quot;messages&quot;:[{&quot;role&quot;:&quot;user&quot;,&quot;content&quot;:&quot;hi&quot;}]}'"/>
                    <TextBlock FontFamily="{StaticResource FontMono}" FontSize="10.5"
                               Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap" Margin="2,2,0,0"
                               Text="curl http://127.0.0.1:8766/v1/responses -H &quot;Authorization: Bearer &lt;令牌&gt;&quot; -d '{&quot;model&quot;:&quot;trae&quot;,&quot;input&quot;:&quot;hi&quot;}'"/>
                </StackPanel>
            </Border>

            <!-- 模型列表（四层来源聚合，可增删改） -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="人工 &gt; 官网 &gt; 内置 &gt; 推断"
                                   Style="{StaticResource CardMeta}" VerticalAlignment="Center"/>
                        <TextBlock Text="模型列表" Style="{StaticResource CardTitle}" Margin="0"/>
                    </DockPanel>

                    <TextBlock Text="{Binding ModelListStatus}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource SubBrush}"/>
                    <TextBlock FontSize="10.5" Foreground="{DynamicResource MuteBrush}" TextWrapping="Wrap"
                               Margin="2,4,0,0"
                               Text="「编辑」改展示名/厂商/倍率等字段（留空即交回官网层补齐）；「隐藏」让它从列表与 /v1/models 消失、官网同步也带不回来，勾选「显示已隐藏」可恢复；「删除」只清掉本地设置。"/>

                    <TextBlock Text="当前列表" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>

                    <!-- 表头：模型 ID / 展示名 / 厂商 / 倍率 / 思考档位 / 默认上下文 / 长上下文 / 图片 / 操作 -->
                    <Grid Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="42"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="168"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="模型 ID" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MuteBrush}"/>
                        <TextBlock Grid.Column="1" Text="展示名" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MuteBrush}"/>
                        <TextBlock Grid.Column="2" Text="厂商" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MuteBrush}"/>
                        <TextBlock Grid.Column="3" Text="倍率" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MuteBrush}"/>
                        <TextBlock Grid.Column="4" Text="思考档位" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MuteBrush}"/>
                        <TextBlock Grid.Column="5" Text="默认上下文" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MuteBrush}"/>
                        <TextBlock Grid.Column="6" Text="长上下文" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MuteBrush}"/>
                        <TextBlock Grid.Column="7" Text="图片" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MuteBrush}"/>
                        <TextBlock Grid.Column="8" Text="操作" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource MuteBrush}"/>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,2"/>

                    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ModelEntries}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3,0,3">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="52"/>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="54"/>
                                                <ColumnDefinition Width="44"/>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="168"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding IdText}" FontSize="10.5"
                                                       FontFamily="{StaticResource FontMono}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding IdText}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayText}" FontSize="10.5"
                                                       Foreground="{DynamicResource SubBrush}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayText}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding VendorText}" FontSize="10.5"
                                                       Foreground="{DynamicResource SubBrush}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding VendorText}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding RateText}" FontSize="10.5"
                                                       FontFamily="{StaticResource FontMono}"
                                                       Foreground="{DynamicResource SubBrush}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding EffortsText}" FontSize="10"
                                                       Foreground="{DynamicResource SubBrush}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding EffortsText}"/>
                                            <TextBlock Grid.Column="5" Text="{Binding ContextText}" FontSize="10.5"
                                                       FontFamily="{StaticResource FontMono}"
                                                       Foreground="{DynamicResource SubBrush}"/>
                                            <TextBlock Grid.Column="6" Text="{Binding LongContextText}" FontSize="10.5"
                                                       FontFamily="{StaticResource FontMono}"
                                                       Foreground="{DynamicResource SubBrush}"/>
                                            <TextBlock Grid.Column="7" Text="{Binding ImageCellText}" FontSize="10.5"
                                                       HorizontalAlignment="Center"
                                                       Foreground="{DynamicResource SubBrush}"/>
                                            <StackPanel Grid.Column="8" Orientation="Horizontal">
                                                <Button Style="{StaticResource GhostButton}" Padding="7,2" FontSize="9.5"
                                                        Content="复制" Margin="0,0,4,0"
                                                        Visibility="{Binding IsDraft, Converter={x:Static views:BoolToVisConverter.FalseInstance}}"
                                                        Command="{Binding DataContext.CopyTextCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding IdText}"/>
                                                <Button Style="{StaticResource GhostButton}" Padding="7,2" FontSize="9.5"
                                                        Content="编辑" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.EditModelCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource GhostButton}" Padding="7,2" FontSize="9.5"
                                                        Content="隐藏" Margin="0,0,4,0"
                                                        Visibility="{Binding IsHidden, Converter={x:Static views:BoolToVisConverter.FalseInstance}}"
                                                        Command="{Binding DataContext.HideModelCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource GhostButton}" Padding="7,2" FontSize="9.5"
                                                        Content="恢复" Margin="0,0,4,0"
                                                        Visibility="{Binding IsHidden, Converter={x:Static views:BoolToVisConverter.TrueInstance}}"
                                                        Command="{Binding DataContext.RestoreModelCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource GhostDangerButton}" Padding="7,2"
                                                        FontSize="9.5" Content="删除"
                                                        Visibility="{Binding IsCustom, Converter={x:Static views:BoolToVisConverter.TrueInstance}}"
                                                        Command="{Binding DataContext.RemoveModelOverrideCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 编辑表单：列宽只有几十像素，塞不下输入框，所以在行下方展开 -->
                                        <Border Margin="0,6,0,4" Padding="10,8"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                CornerRadius="6"
                                                Visibility="{Binding IsEditing, Converter={x:Static views:BoolToVisConverter.TrueInstance}}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="模型 ID"
                                                               Style="{StaticResource FieldLabel}" Margin="0,0,8,6"
                                                               VerticalAlignment="Center"/>
                                                    <TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Input}"
                                                             FontSize="10.5" Margin="0,0,12,6"
                                                             Text="{Binding EditId, UpdateSourceTrigger=PropertyChanged}"
                                                             IsReadOnly="{Binding IsDraft, Converter={x:Static views:InvertBoolConverter.Instance}}"
                                                             ToolTip="上游可接受的 config_name；只有新增时才能改"/>

                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="展示名"
                                                               Style="{StaticResource FieldLabel}" Margin="0,0,8,6"
                                                               VerticalAlignment="Center"/>
                                                    <TextBox Grid.Row="0" Grid.Column="3" Style="{StaticResource Input}"
                                                             FontSize="10.5" Margin="0,0,0,6"
                                                             Text="{Binding EditDisplay, UpdateSourceTrigger=PropertyChanged}"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="厂商"
                                                               Style="{StaticResource FieldLabel}" Margin="0,0,8,6"
                                                               VerticalAlignment="Center"/>
                                                    <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Input}"
                                                             FontSize="10.5" Margin="0,0,12,6"
                                                             Text="{Binding EditVendor, UpdateSourceTrigger=PropertyChanged}"/>

                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="倍率"
                                                               Style="{StaticResource FieldLabel}" Margin="0,0,8,6"
                                                               VerticalAlignment="Center"/>
                                                    <TextBox Grid.Row="1" Grid.Column="3" Style="{StaticResource Input}"
                                                             FontSize="10.5" Margin="0,0,0,6"
                                                             Text="{Binding EditRate, UpdateSourceTrigger=PropertyChanged}"/>

                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="思考档位"
                                                               Style="{StaticResource FieldLabel}" Margin="0,0,8,6"
                                                               VerticalAlignment="Center"/>
                                                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Input}"
                                                             FontSize="10.5" Margin="0,0,12,6"
                                                             Text="{Binding EditEfforts, UpdateSourceTrigger=PropertyChanged}"/>

                                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="默认上下文"
                                                               Style="{StaticResource FieldLabel}" Margin="0,0,8,6"
                                                               VerticalAlignment="Center"/>
                                                    <TextBox Grid.Row="2" Grid.Column="3" Style="{StaticResource Input}"
                                                             FontSize="10.5" Margin="0,0,0,6"
                                                             Text="{Binding EditContext, UpdateSourceTrigger=PropertyChanged}"/>

                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="长上下文"
                                                               Style="{StaticResource FieldLabel}" Margin="0,0,8,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Input}"
                                                             FontSize="10.5" Margin="0,0,12,0"
                                                             Text="{Binding EditLongContext, UpdateSourceTrigger=PropertyChanged}"/>

                                                    <TextBlock Grid.Row="3" Grid.Column="2" Text="图片"
                                                               Style="{StaticResource FieldLabel}" Margin="0,0,8,0"
                                                               VerticalAlignment="Center"/>
                                                    <ComboBox Grid.Row="3" Grid.Column="3" Style="{StaticResource Combo}"
                                                              MinHeight="26" FontSize="10.5"
                                                              SelectedItem="{Binding EditImage}"
                                                              ItemsSource="{Binding DataContext.ImageOptions,
                                                                            RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                                </Grid>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                            Margin="0,8,0,0">
                                                    <Button Style="{StaticResource AccentButton}" Padding="12,3"
                                                            FontSize="10.5" Content="保存" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.SaveModelCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource GhostButton}" Padding="12,3"
                                                            FontSize="10.5" Content="取消"
                                                            Command="{Binding DataContext.CancelModelEditCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="还没有模型——点「更新模型列表」拉取，或点「新增模型」手工加一条"
                               FontSize="11" Foreground="{DynamicResource MuteBrush}" Margin="0,6,0,0"
                               Visibility="{Binding ModelListEmpty, Converter={x:Static views:BoolToVisConverter.TrueInstance}}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="新增模型"
                                Command="{Binding AddModelCommand}"/>
                        <Button Style="{StaticResource GhostButton}" Content="更新模型列表" Margin="8,0,0,0"
                                Command="{Binding UpdateModelListCommand}"
                                IsEnabled="{Binding Busy, Converter={x:Static views:InvertBoolConverter.Instance}}"/>
                        <CheckBox Style="{StaticResource Check}" Content="显示已隐藏" FontSize="11"
                                  Margin="14,0,0,0" VerticalAlignment="Center"
                                  IsChecked="{Binding ShowHiddenModels}"
                                  ToolTip="把隐藏（删除过）的模型灰显列出，可一键恢复"/>
                        <TextBlock Text="清缓存并重新同步官网源" FontSize="10.5"
                                   Foreground="{DynamicResource MuteBrush}"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
