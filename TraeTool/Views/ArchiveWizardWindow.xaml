<Window x:Class="TraeTool.Views.ArchiveWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:TraeTool.Resources"
        Title="建立客户端档案"
        Width="520" SizeToContent="Height" MinHeight="420"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource FontBody}" FontSize="12.5">
    <!-- 步骤样式挂在 Window 级：codebehind BuildSteps 用窗口 FindResource 查找
         （FindResource 只搜自身+祖先+Application，不搜子孙元素！挂在子元素上会抛异常） -->
    <Window.Resources>
        <Style x:Key="StepName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource MuteBrush}"/>
        </Style>
        <Style x:Key="StepDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="8.5"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource MuteBrush}"/>
            <Setter Property="Opacity" Value="0.85"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Padding="0"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#121820" BlurRadius="26" ShadowDepth="8" Direction="270" Opacity="0.2"/>
            </Border.Effect>
            <DockPanel>

                <!-- 头部 -->
                <Border DockPanel.Dock="Top" Padding="20,16,14,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource MiniButton}"
                                VerticalAlignment="Top" Click="OnCancelClick" ToolTip="取消">
                            <Path Data="{x:Static icons:Icons.X}" Style="{StaticResource Ico}"
                                  Width="11" Height="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="11"
                                    Background="{DynamicResource PrimarySoftBrush}" Margin="0,0,12,0">
                                <Path Data="{x:Static icons:Icons.Shield}" Style="{StaticResource Ico}"
                                      Width="18" Height="18" Stroke="{DynamicResource PrimaryBrush}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="建立客户端档案" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="SubtitleText" Text="为账号备份一次 Trae 客户端登录态"
                                           FontSize="10.5" Foreground="{DynamicResource MuteBrush}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 步骤指示器（每步：编号 + 名称 + 小字，10.4a） -->
                <Border DockPanel.Dock="Top" Padding="20,14,20,0">
                    <StackPanel x:Name="StepsRow" Orientation="Horizontal">
                        <!-- 五步在 codebehind 构建 -->
                    </StackPanel>
                </Border>

                <!-- 正文 -->
                <StackPanel DockPanel.Dock="Top" Margin="20,14,20,0" MinHeight="150">
                    <TextBlock x:Name="BodyTitle" Text="" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="BodyDesc" Text="" FontSize="11.5"
                               Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap"
                               Margin="0,6,0,0" LineHeight="18"/>

                    <ItemsControl x:Name="BulletsList" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,5">
                                    <Path DockPanel.Dock="Left" Data="{x:Static icons:Icons.Check}" Style="{StaticResource Ico}"
                                          Width="12" Height="12" Stroke="{DynamicResource SuccessBrush}"
                                          Margin="1,2,7,0"/>
                                    <TextBlock Text="{Binding}" FontSize="11"
                                               Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 交叉比对警告（≥0.85） -->
                    <Border x:Name="WarnBox" Background="{DynamicResource WarnSoftBrush}"
                            BorderBrush="{DynamicResource WarnLineBrush}" BorderThickness="1"
                            CornerRadius="9" Padding="11,9" Margin="0,10,0,0"
                            Visibility="Collapsed">
                        <DockPanel>
                            <Path DockPanel.Dock="Left" Data="{x:Static icons:Icons.Alert}" Style="{StaticResource Ico}"
                                  Width="14" Height="14" Stroke="{DynamicResource WarnBrush}"
                                  Margin="0,1,8,0"/>
                            <TextBlock x:Name="WarnText" FontSize="11" Foreground="{DynamicResource WarnBrush}"
                                       TextWrapping="Wrap"/>
                        </DockPanel>
                    </Border>

                    <!-- 确认勾选（warn 才出现，主按钮由它放行） -->
                    <CheckBox x:Name="ConfirmCheck" Style="{StaticResource Check}" FontSize="11.5"
                              Margin="0,10,0,0" Visibility="Collapsed" Checked="OnCheckChanged"
                              Unchecked="OnCheckChanged">
                        <TextBlock x:Name="ConfirmText" Text="" FontSize="11.5"
                                   Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap"/>
                    </CheckBox>

                    <!-- 进度日志 -->
                    <Border x:Name="ProgressBox" Style="{StaticResource LogBox}" Margin="0,10,0,0"
                            MaxHeight="140" Visibility="Collapsed">
                        <ScrollViewer x:Name="ProgressScroll" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ProgressLines"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <!-- 底部 -->
                <Border DockPanel.Dock="Bottom" Padding="20,12,20,16">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                    VerticalAlignment="Center" MaxWidth="260">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                     Fill="{DynamicResource MuteBrush}" Margin="0,0,7,0"
                                     VerticalAlignment="Center" Visibility="Collapsed"/>
                            <TextBlock x:Name="StatusText" Text="" FontSize="10.5"
                                       Foreground="{DynamicResource MuteBrush}" VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="SecondaryButton" Style="{StaticResource GhostButton}"
                                    MinWidth="76" Margin="0,0,8,0" Content="取消"
                                    Click="OnCancelClick"/>
                            <Button x:Name="PrimaryButton" Style="{StaticResource AccentButton}"
                                    MinWidth="92" Content="下一步" Click="OnPrimaryClick"
                                    IsEnabled="False"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
