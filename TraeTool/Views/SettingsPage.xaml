<UserControl x:Class="TraeTool.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TraeTool.Views"
             xmlns:icons="clr-namespace:TraeTool.Resources"
             xmlns:svc="clr-namespace:TraeTool.Services"
             Background="{DynamicResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
        <StackPanel MaxWidth="720" HorizontalAlignment="Left">

            <!-- P6-1 页头 -->
            <DockPanel Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="通用行为与关于 · 账号相关配置在「账号管理」" Style="{StaticResource PageMeta}"/>
                </StackPanel>
            </DockPanel>

            <!-- 状态横幅：复制 Token 等操作的即时回执（此前点了没反应） -->
            <Border Style="{StaticResource BannerInfo}" Margin="0,0,0,12"
                    Visibility="{Binding StatusMessage, Converter={x:Static views:NonEmptyConverter.Instance}}">
                <DockPanel>
                    <Path DockPanel.Dock="Left" Data="{x:Static icons:Icons.Info}" Style="{StaticResource Ico}"
                          Width="14" Height="14" Stroke="{DynamicResource PrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5"
                               Foreground="{DynamicResource PrimaryStrongBrush}" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- P6-2 行为设置卡 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="立即生效" Style="{StaticResource CardMeta}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="行为设置" Style="{StaticResource CardTitle}" Margin="0"/>
                    </DockPanel>

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding StartWithWindows}"
                              Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="开机自动启动" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="登录 Windows 后自动运行，静默收至托盘。"
                                       FontSize="10" Foreground="{DynamicResource MuteBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding CloseToTray}"
                              Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="关闭窗口时收到系统托盘" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="后台继续自动签到；点击托盘图标可恢复窗口。"
                                       FontSize="10" Foreground="{DynamicResource MuteBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding UseClientDeviceId}"
                              Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock Text="新账号优先使用本机 Trae 客户端真实设备号" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="每个账号会独立生成 16 位设备号；共用同一设备号会被服务端每日去重。"
                                       FontSize="10" Foreground="{DynamicResource MuteBrush}" Margin="0,2,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </CheckBox>

                    <DockPanel Margin="0,10,0,0">
                        <Path DockPanel.Dock="Left" Data="{x:Static icons:Icons.Shield}" Style="{StaticResource Ico}"
                              Width="13" Height="13" Stroke="{DynamicResource MuteBrush}" Margin="0,0,7,0"/>
                        <TextBlock Text="设备号仅保存在本机配置中，不会随档案上传。"
                                   FontSize="10.5" Foreground="{DynamicResource MuteBrush}"
                                   TextWrapping="Wrap"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 外观（浅色/深色，即时生效） -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="即时生效" Style="{StaticResource CardMeta}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="外观" Style="{StaticResource CardTitle}" Margin="0"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="theme" Content="浅色" FontSize="12.5"
                                     Foreground="{DynamicResource TextBrush}"
                                     IsChecked="{Binding ThemeDark, Converter={x:Static views:InvertBoolConverter.Instance}}"
                                     Margin="0,0,22,0" VerticalAlignment="Center"/>
                        <RadioButton GroupName="theme" Content="深色" FontSize="12.5"
                                     Foreground="{DynamicResource TextBrush}"
                                     IsChecked="{Binding ThemeDark}"
                                     VerticalAlignment="Center"/>
                        <TextBlock Text="切换后立即应用并记住选择" FontSize="10.5"
                                   Foreground="{DynamicResource MuteBrush}"
                                   VerticalAlignment="Center" Margin="18,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 账号 Token（查看与复制） -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="点击复制完整 Token 到剪贴板"
                                   Style="{StaticResource CardMeta}" VerticalAlignment="Center"/>
                        <TextBlock Text="账号 Token" Style="{StaticResource CardTitle}" Margin="0"/>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,7" BorderThickness="0,0,0,1"
                                        BorderBrush="{DynamicResource BorderBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="12"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TokenMask}" FontSize="11"
                                                   FontFamily="{StaticResource FontMono}"
                                                   Foreground="{DynamicResource SubBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding TokenUpdatedText}" FontSize="10"
                                                   Foreground="{DynamicResource MuteBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <Button Grid.Column="3" Style="{StaticResource GhostButton}"
                                                Padding="10,4" FontSize="11"
                                                Content="复制"
                                                Command="{Binding DataContext.CopyTokenCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="还没有账号" FontSize="11"
                               Foreground="{DynamicResource MuteBrush}" Margin="0,4,0,0"
                               Visibility="{Binding Rows.Count, Converter={x:Static views:ZeroToVisConverter.Instance}}"/>
                </StackPanel>
            </Border>

            <!-- 检查更新 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource CardMeta}"
                                   VerticalAlignment="Center"
                                   Text="{x:Static svc:UpdateService.CurrentVersionText}"/>
                        <TextBlock Text="检查更新" Style="{StaticResource CardTitle}" Margin="0"/>
                    </DockPanel>

                    <TextBlock Text="更新源 URL" Style="{StaticResource FieldLabel}"/>
                    <TextBox Style="{StaticResource Input}"
                             Text="{Binding UpdateFeedUrl, UpdateSourceTrigger=LostFocus}"
                             ToolTip="GitHub Releases API（…/repos/owner/repo/releases/latest）或 version.json 地址"/>
                    <TextBlock FontSize="10.5" Foreground="{DynamicResource MuteBrush}"
                               TextWrapping="Wrap" Margin="2,5,0,0"
                               Text="留空 = 使用内置默认源（项目开源发布到 GitHub 后生效，无需再填）；也可自定义 GitHub Releases API 或 version.json 地址。更新包为 .zip，安装时自动退出并覆盖重启。"/>

                    <TextBlock Text="{Binding UpdateStatus}" FontSize="11.5" Margin="2,9,0,0"
                               TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SubBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="检查更新"
                                Command="{Binding CheckUpdateCommand}"
                                IsEnabled="{Binding Busy, Converter={x:Static views:InvertBoolConverter.Instance}}"/>
                        <Button Style="{StaticResource AccentButton}" Content="下载并重启安装"
                                Margin="10,0,0,0" Command="{Binding InstallUpdateCommand}"
                                Visibility="{Binding UpdateAvailable, Converter={x:Static views:BoolToVisConverter.TrueInstance}}"
                                IsEnabled="{Binding Busy, Converter={x:Static views:InvertBoolConverter.Instance}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 设备标识重置（本机客户端指纹运维工具） -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock DockPanel.Dock="Right" Text="重置前自动关客户端并备份原文件"
                                   Style="{StaticResource CardMeta}" VerticalAlignment="Center"/>
                        <TextBlock Text="设备标识重置" Style="{StaticResource CardTitle}" Margin="0"/>
                    </DockPanel>

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding ResetClientMachineId}"
                              Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Trae 客户端 machineid 文件" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="重新生成 UUID（%APPDATA%\Trae CN\machineid）" FontSize="10"
                                       Foreground="{DynamicResource MuteBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding ResetTelemetry}"
                              Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="storage.json 遥测标识三项" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="telemetry.machineId / sqmId / devDeviceId 重新生成" FontSize="10"
                                       Foreground="{DynamicResource MuteBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding ResetAccountDeviceIds}"
                              Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="本工具全部账号 x-device-id" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="每个账号重新生成独立的 16 位设备号" FontSize="10"
                                       Foreground="{DynamicResource MuteBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </CheckBox>

                    <CheckBox Style="{StaticResource Check}" IsChecked="{Binding ResetMachineGuid}"
                              Margin="0,0,0,4">
                        <StackPanel>
                            <TextBlock FontSize="12.5" FontWeight="SemiBold">
                                <Run Text="[高级] Windows MachineGuid" Foreground="{DynamicResource DangerBrush}"/>
                            </TextBlock>
                            <TextBlock Text="系统级标识，影响其他软件的设备识别；写入 HKLM 需要管理员权限。"
                                       FontSize="10" Foreground="{DynamicResource DangerBrush}"
                                       Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </CheckBox>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource DangerButton}" Content="开始重置"
                                Command="{Binding ResetDeviceIdentifiersCommand}"
                                IsEnabled="{Binding Busy, Converter={x:Static views:InvertBoolConverter.Instance}}"/>
                        <TextBlock FontSize="10.5" Foreground="{DynamicResource MuteBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0"
                                   Text="aha/TinyStorage 等其余标识结构暂不支持；原文件备份在 %TEMP%\traedevreset_*。"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 备份与恢复 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" Text="配置(密文) + 签到库 + 用量缓存"
                                   Style="{StaticResource CardMeta}" VerticalAlignment="Center"/>
                        <TextBlock Text="备份与恢复" Style="{StaticResource CardTitle}" Margin="0"/>
                    </DockPanel>
                    <TextBlock FontSize="11" Foreground="{DynamicResource SubBrush}" TextWrapping="Wrap"
                               Margin="0,0,0,10"
                               Text="导出为 zip；配置内凭据是 DPAPI 密文，只能在本机同一 Windows 账户下恢复。导入会覆盖当前数据，重启后生效。"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}" Content="导出备份…"
                                Command="{Binding ExportBackupCommand}"
                                IsEnabled="{Binding Busy, Converter={x:Static views:InvertBoolConverter.Instance}}"/>
                        <Button Style="{StaticResource GhostDangerButton}" Content="导入备份…"
                                Margin="10,0,0,0" Command="{Binding ImportBackupCommand}"
                                IsEnabled="{Binding Busy, Converter={x:Static views:InvertBoolConverter.Instance}}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 日志（最近 150 行） -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource GhostButton}" Padding="10,4" FontSize="11"
                                    Content="刷新" Click="OnLogRefreshClick"/>
                            <Button Style="{StaticResource GhostButton}" Padding="10,4" FontSize="11"
                                    Content="打开日志文件夹" Margin="8,0,0,0" Click="OnOpenLogDirClick"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" x:Name="LogMetaText"
                                   Text="点击「刷新」重新读取" FontSize="10"
                                   Foreground="{DynamicResource MuteBrush}"
                                   VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <TextBlock Text="运行日志" Style="{StaticResource CardTitle}" Margin="0"/>
                    </DockPanel>
                    <Border Style="{StaticResource LogBox}" Height="170">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="LogScroll">
                            <TextBlock x:Name="LogTextBlock" Style="{StaticResource LogText}"
                                       Text="正在读取日志…"/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <!-- P6-3 关于卡 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Border Width="34" Height="34" CornerRadius="10"
                                Background="{DynamicResource PrimaryBrush}" DockPanel.Dock="Left"
                                VerticalAlignment="Top">
                            <TextBlock Text="T" FontFamily="{StaticResource FontDisplay}" FontSize="17"
                                       FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="TraeTool" FontSize="13.5" FontWeight="Bold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="4" Padding="5,1" Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static svc:UpdateService.CurrentVersionText}"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="9.5" Foreground="{DynamicResource SubBrush}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="多账号签到与客户端切换工具 · 单实例运行" FontSize="10.5"
                                       Foreground="{DynamicResource MuteBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="日志位置" FontSize="10.5"
                                   Foreground="{DynamicResource MuteBrush}" Margin="0,0,0,7"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="%LOCALAPPDATA%\TraeTool\logs\"
                                   FontFamily="{StaticResource FontMono}" FontSize="10.5"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,7"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="配置存储" FontSize="10.5"
                                   Foreground="{DynamicResource MuteBrush}" Margin="0,0,0,7"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="DPAPI 加密 · 仅当前 Windows 用户可解密"
                                   FontSize="10.5" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,7"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="单实例" FontSize="10.5"
                                   Foreground="{DynamicResource MuteBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="重复启动会唤醒已有窗口，避免重复签到"
                                   FontSize="10.5" Foreground="{DynamicResource TextBrush}"/>
                    </Grid>

                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,12,0,10"/>
                    <TextBlock Text="本工具为本地效率工具，与 Trae 官方无关。签到与切换均在本机完成，不上传账号凭据。"
                               FontSize="10" Foreground="{DynamicResource MuteBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
