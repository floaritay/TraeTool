<UserControl x:Class="TraeTool.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TraeTool.ViewModels"
             xmlns:views="clr-namespace:TraeTool.Views"
             xmlns:icons="clr-namespace:TraeTool.Resources"
             Background="{DynamicResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
        <StackPanel>

            <!-- P1-1 页头 -->
            <DockPanel Margin="0,0,0,14">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding Busy, Converter={x:Static views:InvertBoolConverter.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{x:Static icons:Icons.Refresh}" Style="{StaticResource Ico}"
                                  Width="13" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Margin="0,0,7,0"/>
                            <TextBlock Text="刷新" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentButton}"
                            Command="{Binding QuickCheckinCommand}"
                            IsEnabled="{Binding Busy, Converter={x:Static views:InvertBoolConverter.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{x:Static icons:Icons.CheckCheck}" Style="{StaticResource Ico}"
                                  Width="14" Height="14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Margin="0,0,8,0"/>
                            <StackPanel>
                                <TextBlock Text="立即签到" Style="{StaticResource BtnMain}"/>
                                <TextBlock Text="全部启用账号" Style="{StaticResource BtnSub}"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="仪表盘" Style="{StaticResource PageTitle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Path Data="{x:Static icons:Icons.Calendar}" Style="{StaticResource Ico}"
                              Width="12" Height="12" Stroke="{DynamicResource MuteBrush}" Margin="0,1,6,0"/>
                        <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="{DynamicResource MuteBrush}"/>
                        <Border Width="3" Height="3" Background="{DynamicResource BorderStrongBrush}"
                                CornerRadius="1.5" Margin="7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MetaText}" FontSize="11" Foreground="{DynamicResource MuteBrush}"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- P1-2 状态横幅：红=错误，蓝=快捷签到进度/汇总（中性信息独立成条，避免误染红） -->
            <Border Style="{StaticResource Banner}" Margin="0,0,0,12"
                    Visibility="{Binding StatusMessage, Converter={x:Static views:NonEmptyConverter.Instance}}">
                <DockPanel>
                    <Path DockPanel.Dock="Left" Data="{x:Static icons:Icons.Alert}" Style="{StaticResource Ico}"
                          Width="14" Height="14" Stroke="{DynamicResource DangerBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BannerText}"/>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource BannerInfo}" Margin="0,0,0,12"
                    Visibility="{Binding InfoMessage, Converter={x:Static views:NonEmptyConverter.Instance}}">
                <DockPanel>
                    <Path DockPanel.Dock="Left" Data="{x:Static icons:Icons.Info}" Style="{StaticResource Ico}"
                          Width="14" Height="14" Stroke="{DynamicResource PrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding InfoMessage}" FontSize="11.5"
                               Foreground="{DynamicResource PrimaryStrongBrush}" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- P1-3 统计卡组 -->
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,7,12" Padding="13,11"
                        Background="{DynamicResource PrimarySoftBrush}"
                        BorderBrush="{DynamicResource PrimaryLineBrush}">
                    <Grid>
                        <Path Data="{x:Static icons:Icons.Wallet}" Style="{StaticResource Ico}"
                              Width="17" Height="17" HorizontalAlignment="Right" VerticalAlignment="Top"
                              Stroke="{DynamicResource PrimaryLineBrush}"/>
                        <StackPanel>
                            <TextBlock Text="剩余积分" Style="{StaticResource StatLabel}"
                                       Foreground="{DynamicResource PrimaryStrongBrush}"/>
                            <TextBlock Text="{Binding RemainingCredits}" Style="{StaticResource StatValue}"
                                       Foreground="{DynamicResource PrimaryBrush}" FontSize="27"/>
                            <TextBlock Text="{Binding CurrentAccount}" Style="{StaticResource StatSub}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,7,12" Padding="13,11" MinHeight="86">
                    <Grid>
                        <Path Data="{x:Static icons:Icons.Activity}" Style="{StaticResource Ico}"
                              Width="17" Height="17" HorizontalAlignment="Right" VerticalAlignment="Top"
                              Stroke="{DynamicResource BorderStrongBrush}"/>
                        <StackPanel>
                            <TextBlock Text="今日状态" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding TodayStatus}" Style="{StaticResource StatValueSm}"/>
                            <TextBlock Text="当前账号" Style="{StaticResource StatSub}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,7,12" Padding="13,11" MinHeight="86">
                    <Grid>
                        <Path Data="{x:Static icons:Icons.Zap}" Style="{StaticResource Ico}"
                              Width="17" Height="17" HorizontalAlignment="Right" VerticalAlignment="Top"
                              Stroke="{DynamicResource BorderStrongBrush}"/>
                        <StackPanel>
                            <TextBlock Text="今日总获得" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding TodayReward}" Style="{StaticResource StatValueSm}"
                                       Foreground="{DynamicResource SuccessBrush}"/>
                            <TextBlock Text="全部启用账号合计" Style="{StaticResource StatSub}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="3" Style="{StaticResource Card}" Padding="13,11" MinHeight="86">
                    <Grid>
                        <Path Data="{x:Static icons:Icons.Flame}" Style="{StaticResource Ico}"
                              Width="17" Height="17" HorizontalAlignment="Right" VerticalAlignment="Top"
                              Stroke="{DynamicResource BorderStrongBrush}"/>
                        <StackPanel>
                            <TextBlock Text="连续签到" Style="{StaticResource StatLabel}"/>
                            <TextBlock Text="{Binding StreakText}" Style="{StaticResource StatValueSm}"
                                       Foreground="{DynamicResource WarnBrush}"/>
                            <TextBlock Text="保持中不断签" Style="{StaticResource StatSub}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- P1-4 会员状态条 -->
            <Border Style="{StaticResource Chip}" Margin="0,0,0,12" Padding="11,6"
                    Background="{DynamicResource SurfaceBrush}"
                    HorizontalAlignment="Left"
                    Visibility="{Binding MemberText, Converter={x:Static views:NonEmptyConverter.Instance}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,7,0"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding MemberText}" FontSize="11" Foreground="{DynamicResource SubBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="来自客户端 entitlementInfo" FontSize="9.5"
                               Foreground="{DynamicResource MuteBrush}" Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- P1-5 积分趋势卡 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="积分快照 · 每日签到后记录"
                                   Style="{StaticResource CardMeta}" VerticalAlignment="Center"/>
                        <TextBlock Text="剩余积分趋势（近 14 天）" Style="{StaticResource CardTitle}" Margin="0"/>
                    </DockPanel>

                    <Grid Height="165"
                          Visibility="{Binding HasTrend, Converter={x:Static views:BoolToVisConverter.TrueInstance}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding ChartYMax}" FontSize="10"
                                       Foreground="{DynamicResource MuteBrush}" VerticalAlignment="Top"/>
                            <TextBlock Grid.Row="1" Text="{Binding ChartYMid}" FontSize="10"
                                       Foreground="{DynamicResource MuteBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="2" Text="{Binding ChartYMin}" FontSize="10"
                                       Foreground="{DynamicResource MuteBrush}" VerticalAlignment="Bottom"/>
                        </Grid>
                        <Canvas x:Name="TrendCanvas" Grid.Column="1" ClipToBounds="True"
                                SizeChanged="OnTrendSizeChanged">
                            <Polygon Points="{Binding FillPoints}" Fill="#332C5BF6"/>
                            <Polyline Points="{Binding LinePoints}" Stroke="{DynamicResource PrimaryBrush}"
                                      StrokeThickness="2.5" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Width="11" Height="11" Fill="{DynamicResource PrimaryBrush}"
                                     Stroke="White" StrokeThickness="2"
                                     Canvas.Left="{Binding TodayX}" Canvas.Top="{Binding TodayY}"/>
                        </Canvas>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding AxisLabels}" Margin="46,4,0,0"
                                  Visibility="{Binding HasTrend, Converter={x:Static views:BoolToVisConverter.TrueInstance}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding AxisLabels.Count}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource MuteBrush}"
                                           HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Height="165" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasTrend, Converter={x:Static views:InvertBoolToVisConverter.Instance}}">
                        <StackPanel>
                            <Border Style="{StaticResource EmptyIllus}">
                                <Path Data="{x:Static icons:Icons.Chart}" Style="{StaticResource Ico}"
                                      Width="22" Height="22" Stroke="{DynamicResource MuteBrush}"/>
                            </Border>
                            <TextBlock Text="暂无趋势数据（签到 / 刷新后开始记录）" Style="{StaticResource EmptyText}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- P1-6 / P1-7 日历 + 账号速览 -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,12" Padding="14,12">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource MiniButton}" Content="‹"
                                        Command="{Binding PrevMonthCommand}" FontSize="13"/>
                                <Button Style="{StaticResource MiniButton}" Content="›" Margin="5,0,0,0"
                                        Command="{Binding NextMonthCommand}" FontSize="13"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MonthTitle}" FontWeight="SemiBold" FontSize="12.5"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding WeekHeader}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="10"
                                               Foreground="{DynamicResource MuteBrush}"
                                               HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding CalendarDays}" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="34" Height="30" CornerRadius="7" Margin="1.5"
                                            ToolTip="{Binding Tip}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="checked">
                                                        <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="today">
                                                        <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Day}" FontSize="11"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SubBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="checked">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="today">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}"/>
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,5,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="已签" FontSize="10" Foreground="{DynamicResource MuteBrush}"
                                       VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource WarnSoftBrush}"
                                     Stroke="{DynamicResource WarnLineBrush}" Margin="0,0,5,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="今天" FontSize="10" Foreground="{DynamicResource MuteBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel Margin="15,12,15,6">
                            <TextBlock DockPanel.Dock="Right" Text="点击行 → 切换当前查看账号"
                                       Style="{StaticResource CardMeta}" VerticalAlignment="Center"/>
                            <TextBlock Text="账号速览" Style="{StaticResource CardTitle}" Margin="0"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding AccountRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:DashAccountRow}">
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                            Padding="15,9" Cursor="Hand"
                                            MouseLeftButtonUp="OnAccountRowClick">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="30" Height="30" CornerRadius="15" VerticalAlignment="Center">
                                                <Grid>
                                                    <Ellipse Fill="{Binding AvatarHue, Converter={x:Static views:HueToBrushConverter.Instance}}"
                                                             Visibility="{Binding AvatarImage, Converter={x:Static views:NullToVisConverter.Instance}}"/>
                                                    <Ellipse Fill="{Binding AvatarImage, Converter={x:Static views:ImageToBrushConverter.Instance}}"
                                                             Visibility="{Binding AvatarImage, Converter={x:Static views:NotNullToVisConverter.Instance}}"/>
                                                    <TextBlock Text="{Binding Initial}" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding AvatarImage, Converter={x:Static views:NullToVisConverter.Instance}}"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               FontSize="12.5"
                                                               Foreground="{DynamicResource TextBrush}"/>
                                                    <Border Style="{StaticResource Badge}"
                                                            Background="{DynamicResource PrimarySoftBrush}"
                                                            BorderBrush="{DynamicResource PrimaryLineBrush}"
                                                            Visibility="{Binding IsCurrent, Converter={x:Static views:BoolToVisConverter.TrueInstance}}">
                                                        <TextBlock Text="当前" Style="{StaticResource BadgeCurrent}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Sub}" FontSize="10.5"
                                                           Foreground="{DynamicResource SubBrush}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="还没有账号——到「账号管理」添加" FontSize="11"
                                   Foreground="{DynamicResource MuteBrush}" Margin="15,4,15,12"
                                   Visibility="{Binding AccountRows.Count, Converter={x:Static views:ZeroToVisConverter.Instance}}"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
