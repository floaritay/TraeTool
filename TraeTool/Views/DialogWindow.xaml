<Window x:Class="TraeTool.Views.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="clr-namespace:TraeTool.Resources"
        Title="确认"
        Width="430" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource FontBody}" FontSize="12.5"
        KeyDown="OnKeyDown">
    <Grid Margin="14">
        <Border x:Name="CardBorder" Background="{DynamicResource SurfaceBrush}" CornerRadius="14" Padding="20,18"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#121820" BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.18"/>
            </Border.Effect>
            <StackPanel>
                <!-- 头 -->
                <DockPanel Margin="0,0,0,12">
                    <Border x:Name="IconCircle" DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17"
                            Background="{DynamicResource PrimarySoftBrush}" Margin="0,0,11,0"
                            VerticalAlignment="Top">
                        <Path x:Name="IconPath" Data="{x:Static icons:Icons.Info}"
                              Style="{StaticResource Ico}" Width="17" Height="17"
                              Stroke="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TitleText" Text="标题" FontSize="14.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </DockPanel>

                <!-- 正文 -->
                <TextBlock x:Name="MessageText" FontSize="12" Foreground="{DynamicResource SubBrush}"
                           TextWrapping="Wrap" LineHeight="19"/>

                <!-- 后果小字（10.4d） -->
                <TextBlock x:Name="SmallText" FontSize="10.5" Foreground="{DynamicResource MuteBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed"/>

                <!-- 按钮 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="SecondaryButton" Style="{StaticResource GhostButton}"
                            MinWidth="76" Margin="0,0,8,0" Visibility="Collapsed"
                            Click="OnSecondaryClick"/>
                    <Button x:Name="PrimaryButton" Style="{StaticResource AccentButton}"
                            MinWidth="84" Click="OnPrimaryClick"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
