<Window x:Class="TraeTool.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:icons="clr-namespace:TraeTool.Resources"
        Title="登录 TRAE 账号"
        Icon="/TraeTool;component/app.ico"
        Width="920" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="{StaticResource FontBody}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部提示条 -->
        <Border Grid.Row="0" Background="{DynamicResource Nav2Brush}" Padding="14,9">
            <DockPanel>
                <Button x:Name="BtnClose" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                        Padding="12,5" Content="关闭窗口" Click="OnCloseClick"
                        Background="#1AFFFFFF" BorderBrush="#2AFFFFFF" Foreground="#C9D3E1"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource PrimaryBrush}"
                            Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="T" FontFamily="{StaticResource FontDisplay}" FontSize="11"
                                   FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Path Data="{x:Static icons:Icons.Info}" Style="{StaticResource Ico}"
                          Width="14" Height="14" Stroke="#7C8899" Margin="0,0,8,0"/>
                    <TextBlock VerticalAlignment="Center" Foreground="#C9D3E1" FontSize="11.5"
                               Text="请在下方浏览器内登录 TRAE（手机号 + 验证码）。登录成功后本窗口会自动识别并关闭。"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 内嵌浏览器 -->
        <wv2:WebView2 x:Name="WebView" Grid.Row="1"/>

        <!-- 底部状态条 -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="{x:Static icons:Icons.Shield}" Style="{StaticResource Ico}"
                          Width="13" Height="13" Stroke="{DynamicResource SuccessBrush}" Margin="0,0,6,0"/>
                    <TextBlock Text="凭据将以 DPAPI 加密保存到本机" FontSize="10.5"
                               Foreground="{DynamicResource MuteBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource PrimaryBrush}" Margin="0,0,8,0"
                             VerticalAlignment="Center">
                        <Ellipse.Triggers>
                            <EventTrigger RoutedEvent="Ellipse.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.25" Duration="0:0:0.7"
                                                         AutoReverse="True" RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock x:Name="StatusText" FontSize="11.5"
                               Foreground="{DynamicResource SubBrush}" Text="正在初始化浏览器…"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
