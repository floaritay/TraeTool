<UserControl x:Class="TraeTool.Views.SwitchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TraeTool.ViewModels"
             xmlns:views="clr-namespace:TraeTool.Views"
             xmlns:icons="clr-namespace:TraeTool.Resources"
             Background="{DynamicResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
        <StackPanel>

            <!-- P4-1 页头 -->
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- 路径输入 -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1" CornerRadius="10" Margin="0,0,8,0"
                            Height="30" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{x:Static icons:Icons.Monitor}" Style="{StaticResource Ico}"
                                  Width="14" Height="14" Stroke="{DynamicResource MuteBrush}"
                                  Margin="10,0,8,0"/>
                            <TextBox Style="{StaticResource Input}" Width="218" MinHeight="28"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" FontSize="11"
                                     Text="{Binding ClientExePath, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="客户端 Trae CN.exe 完整路径；留空 = 自动探测默认安装位置">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost" Margin="0"
                                                      VerticalAlignment="Center"/>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                            <TextBlock Text="留空自动探测" FontSize="9.5"
                                       Foreground="{DynamicResource MuteBrush}" VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource GhostButton}" Command="{Binding DetectClientCommand}"
                            IsEnabled="{Binding Busy, Converter={x:Static views:InvertBoolConverter.Instance}}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{x:Static icons:Icons.Refresh}" Style="{StaticResource Ico}"
                                  Width="13" Height="13"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Margin="0,0,7,0"/>
                            <TextBlock Text="检测客户端" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="客户端切换" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="备份 / 回写 Trae 桌面客户端登录态 · 低频但高风险操作"
                               Style="{StaticResource PageMeta}"/>
                </StackPanel>
            </DockPanel>

            <!-- P4-2 客户端状态行 -->
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="11,7" Margin="0,0,0,10"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ClientState}" Value="idle">
                                        <Setter Property="Fill" Value="{DynamicResource WarnBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ClientState}" Value="running">
                                        <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ClientStatusText}" FontSize="11.5"
                               Foreground="{DynamicResource SubBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- P4-3 操作状态行 -->
            <Border Style="{StaticResource BannerInfo}"
                    Visibility="{Binding StatusMessage, Converter={x:Static views:NonEmptyConverter.Instance}}">
                <DockPanel>
                    <Path DockPanel.Dock="Left" Data="{x:Static icons:Icons.Info}" Style="{StaticResource Ico}"
                          Width="14" Height="14" Stroke="{DynamicResource PrimaryBrush}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11.5"
                               Foreground="{DynamicResource PrimaryStrongBrush}" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- P4-4 档案列表卡 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock DockPanel.Dock="Right" Text="按账号保存 · 切换前须先建档"
                                   Style="{StaticResource CardMeta}" VerticalAlignment="Center"/>
                        <TextBlock Text="账号档案" Style="{StaticResource CardTitle}" Margin="0"/>
                    </DockPanel>

                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SwitchAccountRowViewModel}">
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                                        Padding="2,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 信息列用 Grid 分列（36 头像 | * 内容）：
                                             横向 StackPanel 会给子元素无限宽度导致内容画出列外、
                                             钻到右侧按钮底下被盖住——必须用有限的 * 列约束 -->
                                        <Grid Grid.Column="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" VerticalAlignment="Center">
                                                <Grid>
                                                    <Ellipse Fill="{Binding AvatarHue, Converter={x:Static views:HueToBrushConverter.Instance}}"
                                                             Visibility="{Binding AvatarImage, Converter={x:Static views:NullToVisConverter.Instance}}"/>
                                                    <Ellipse Fill="{Binding AvatarImage, Converter={x:Static views:ImageToBrushConverter.Instance}}"
                                                             Visibility="{Binding AvatarImage, Converter={x:Static views:NotNullToVisConverter.Instance}}"/>
                                                    <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="SemiBold" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Visibility="{Binding AvatarImage, Converter={x:Static views:NullToVisConverter.Instance}}"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                                        VerticalAlignment="Center">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <!-- 名字超长时在 150px 内省略（Auto 列无限增长会再次挤进按钮区），完整名看 ToolTip -->
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                                   FontSize="13" MaxWidth="150"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding DisplayName}"
                                                                   Foreground="{DynamicResource TextBrush}"/>
                                                        <Border Style="{StaticResource Badge}"
                                                                Background="{DynamicResource SuccessSoftBrush}"
                                                                BorderBrush="{DynamicResource SuccessLineBrush}"
                                                                Visibility="{Binding IsClientCurrent, Converter={x:Static views:BoolToVisConverter.TrueInstance}}">
                                                            <TextBlock Text="客户端当前" FontSize="10"
                                                                       Foreground="{DynamicResource SuccessBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <Ellipse Width="6" Height="6" Margin="0,0,5,0"
                                                                 VerticalAlignment="Center"
                                                                 Fill="{Binding ArchiveState, Converter={x:Static views:ArchiveStateColorConverter.Instance}}"/>
                                                        <TextBlock Text="{Binding ArchiveState}" FontSize="11.5"
                                                                   Foreground="{Binding ArchiveState, Converter={x:Static views:ArchiveStateColorConverter.Instance}}"/>
                                                    </StackPanel>
                                                    <!-- 明细列吃剩余宽度，超长省略号收尾，绝不越界到按钮区 -->
                                                    <TextBlock Grid.Column="2" Text="{Binding ArchiveDetail}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource MuteBrush}"
                                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                                <!-- 备注行：DockPanel 保证文字拿到有限宽度才能真正换行 -->
                                                <DockPanel Margin="0,3,0,0">
                                                    <Path DockPanel.Dock="Left" Data="{x:Static icons:Icons.Info}"
                                                          Style="{StaticResource Ico}" Width="12" Height="12"
                                                          Stroke="{DynamicResource MuteBrush}" Margin="0,1,6,0"/>
                                                    <TextBlock Text="{Binding IdentityNote}" FontSize="10.5"
                                                               Foreground="{DynamicResource SubBrush}"
                                                               TextWrapping="Wrap"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 操作组（10.3 小字：四钮双行） -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                                    Padding="9,5"
                                                    IsEnabled="{Binding DataContext.Busy, Converter={x:Static views:InvertBoolConverter.Instance},
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.ArchiveCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="建档" Style="{StaticResource BtnMain}"/>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BtnSub}">
                                                                <Setter Property="Text" Value="备份登录态"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ArchiveState}" Value="已备份">
                                                                        <Setter Property="Text" Value="重新备份"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource AccentButton}" Margin="0,0,6,0"
                                                    Padding="9,5"
                                                    IsEnabled="{Binding DataContext.Busy, Converter={x:Static views:InvertBoolConverter.Instance},
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.SwitchToCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource BtnMain}">
                                                                <Setter Property="Text" Value="切换至此"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsClientCurrent}" Value="True">
                                                                        <Setter Property="Text" Value="已是当前"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="重启并切换" Style="{StaticResource BtnSub}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                                                    Padding="9,5"
                                                    ToolTip="排障工具：校验档案完整性与登录态（平时无需使用，建档时已自动交叉比对防错档）"
                                                    IsEnabled="{Binding DataContext.Busy, Converter={x:Static views:InvertBoolConverter.Instance},
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.VerifyCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="排障" Style="{StaticResource BtnMain}"/>
                                                    <TextBlock Text="校验档案" Style="{StaticResource BtnSub}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource GhostDangerButton}" Padding="9,5"
                                                    IsEnabled="{Binding DataContext.Busy, Converter={x:Static views:InvertBoolConverter.Instance},
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Command="{Binding DataContext.DeleteCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel>
                                                    <TextBlock Text="删除" Style="{StaticResource BtnMain}"/>
                                                    <TextBlock Text="删除该档案" Style="{StaticResource BtnSub}"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 空态 -->
                    <StackPanel Margin="0,14,0,6"
                                Visibility="{Binding Rows.Count, Converter={x:Static views:ZeroToVisConverter.Instance}}">
                        <Border Style="{StaticResource EmptyIllus}">
                            <Path Data="{x:Static icons:Icons.Database}" Style="{StaticResource Ico}"
                                  Width="24" Height="24" Stroke="{DynamicResource MuteBrush}"/>
                        </Border>
                        <TextBlock Text="暂无账号档案" Style="{StaticResource EmptyTitle}"/>
                        <TextBlock Style="{StaticResource EmptyText}"
                                   Text="添加账号后，使用「建档」为账号备份一次客户端登录态（需先在客户端登录该账号一次）。"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- P4-5 执行日志卡 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Busy}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimarySoftBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource PrimaryLineBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="10.5">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="空闲"/>
                                            <Setter Property="Foreground" Value="{DynamicResource SubBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Busy}" Value="True">
                                                    <Setter Property="Text" Value="执行中"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Steps.Count}" Value="0">
                                                    <Setter Property="Text" Value="空闲"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <Button Style="{StaticResource GhostButton}" Padding="9,3" Margin="8,0,0,0"
                                    FontSize="10.5" Content="清空" Command="{Binding ClearLogCommand}"
                                    IsEnabled="{Binding Busy, Converter={x:Static views:InvertBoolConverter.Instance}}"/>
                        </StackPanel>
                        <TextBlock Text="执行日志" Style="{StaticResource CardTitle}" Margin="0"/>
                    </DockPanel>

                    <ProgressBar Height="4" Margin="0,0,0,8" Foreground="{DynamicResource PrimaryBrush}"
                                 Background="{DynamicResource BorderBrush}"
                                 IsIndeterminate="{Binding Busy}"
                                 Visibility="{Binding Busy, Converter={x:Static views:BoolToVisConverter.TrueInstance}}"/>

                    <Border Style="{StaticResource Term}" Height="128">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Steps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource TermText}"
                                                       Margin="0,0.5"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource TermText}" Foreground="#6C7A8B"
                                           Visibility="{Binding Steps.Count, Converter={x:Static views:ZeroToVisConverter.Instance}}"
                                           Text="日志将按步骤追加：杀进程 → 快照 → 恢复 → 拉起 → 守护 → 回写"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- 10.4b 步骤图例（首次执行前可见） -->
                    <TextBlock FontSize="10" Foreground="{DynamicResource MuteBrush}" Margin="2,7,0,0"
                               TextWrapping="Wrap"
                               Visibility="{Binding Steps.Count, Converter={x:Static views:ZeroToVisConverter.Instance}}"
                               Text="杀进程＝释放文件占用 · 快照＝可回滚的备份 · 恢复＝写入目标账号档案 · 拉起＝重启客户端 · 守护＝轮询确认登录态 · 回写＝同步刷新后的凭据"/>
                </StackPanel>
            </Border>

            <!-- P4-6 底部说明 -->
            <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,6">
                <StackPanel>
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Data="{x:Static icons:Icons.Shield}" Style="{StaticResource Ico}"
                              Width="13" Height="13" Stroke="{DynamicResource MuteBrush}" Margin="0,2,8,0"/>
                        <TextBlock FontSize="10.5" Foreground="{DynamicResource MuteBrush}" TextWrapping="Wrap"
                                   Text="切换会关闭并重启 Trae 客户端；失败时自动回滚，快照位于 %APPDATA%\TraeTool\switch\rollback_*。"/>
                    </DockPanel>
                    <Expander Margin="0,6,0,0" FontSize="10.5" Foreground="{DynamicResource SubBrush}">
                        <Expander.Header>
                            <TextBlock Text="查看完整说明" FontSize="10.5"
                                       Foreground="{DynamicResource SubBrush}"/>
                        </Expander.Header>
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Text="· 首次切换前需先「建档」：请在客户端手动登录该账号一次。"
                                       FontSize="10.5" Foreground="{DynamicResource MuteBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="· 建档时会与已有档案做相似度比对，≥ 0.85 会提示可能重复。"
                                       FontSize="10.5" Foreground="{DynamicResource MuteBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="· 「排障」用于登录态异常时校验档案完整性，属于低频工具。"
                                       FontSize="10.5" Foreground="{DynamicResource MuteBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBlock Text="· 切换过程中请勿关闭程序，守护步骤会校验客户端登录态。"
                                       FontSize="10.5" Foreground="{DynamicResource MuteBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
