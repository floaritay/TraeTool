<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 浅色主题（默认）。键集合必须与 Dark.xaml 完全一致（ThemeService 运行时整表替换）。 -->
    <SolidColorBrush x:Key="BgBrush" Color="#F3F4F1"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#FAFBF8"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E4E6E1"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#D3D7D0"/>
    <SolidColorBrush x:Key="TextBrush" Color="#151A22"/>
    <SolidColorBrush x:Key="SubBrush" Color="#5B6675"/>
    <SolidColorBrush x:Key="MuteBrush" Color="#939DAB"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="#2C5BF6"/>
    <SolidColorBrush x:Key="PrimaryStrongBrush" Color="#1E45C9"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EEF2FF"/>
    <SolidColorBrush x:Key="PrimaryLineBrush" Color="#D7E0FF"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#0E9B6C"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E8F6F0"/>
    <SolidColorBrush x:Key="SuccessLineBrush" Color="#C8EADB"/>

    <SolidColorBrush x:Key="WarnBrush" Color="#B87513"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#FDF4E3"/>
    <SolidColorBrush x:Key="WarnLineBrush" Color="#F0DCB4"/>

    <SolidColorBrush x:Key="DangerBrush" Color="#CF4141"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FBEDED"/>
    <SolidColorBrush x:Key="DangerLineBrush" Color="#F0CFCF"/>

    <!-- 左导航/标题栏为固定深色 chrome，两主题同值 -->
    <SolidColorBrush x:Key="NavBrush" Color="#151B24"/>
    <SolidColorBrush x:Key="Nav2Brush" Color="#10161D"/>
    <SolidColorBrush x:Key="NavTextBrush" Color="#98A5B7"/>
    <SolidColorBrush x:Key="NavHoverBgBrush" Color="#0CFFFFFF"/>
    <SolidColorBrush x:Key="NavActiveBgBrush" Color="#382C5BF6"/>
    <SolidColorBrush x:Key="NavActiveTextBrush" Color="#F1F5FB"/>
    <SolidColorBrush x:Key="NavActiveIcoBrush" Color="#9CB2FF"/>

    <!-- 组件内联色语义化（浅色值） -->
    <SolidColorBrush x:Key="GhostHoverBgBrush" Color="#FCFCFA"/>
    <SolidColorBrush x:Key="GhostHoverBorderBrush" Color="#AFB8C1"/>
    <SolidColorBrush x:Key="DisabledBgBrush" Color="#F6F7F4"/>
    <SolidColorBrush x:Key="AccentDisabledBgBrush" Color="#B7C1CF"/>
    <SolidColorBrush x:Key="ChipBgBrush" Color="#F1F3EF"/>
    <SolidColorBrush x:Key="LogBoxBgBrush" Color="#F8F9F6"/>
    <SolidColorBrush x:Key="LogBoxBorderBrush" Color="#ECEEE9"/>
    <SolidColorBrush x:Key="LogTextBrush" Color="#6A7684"/>
    <SolidColorBrush x:Key="TermBgBrush" Color="#111821"/>
    <SolidColorBrush x:Key="CheckBorderBrush" Color="#C4CAD2"/>
    <SolidColorBrush x:Key="RowZebraBrush" Color="#FBFCFA"/>

    <!-- 滚动条（轨道透明，只有拇指与悬浮底带可见） -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C9CED6"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A9B1BC"/>
    <SolidColorBrush x:Key="ScrollHoverBgBrush" Color="#14000000"/>
</ResourceDictionary>
