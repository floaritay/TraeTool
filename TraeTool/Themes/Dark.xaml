<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题。键集合必须与 Light.xaml 完全一致（ThemeService 运行时整表替换）。 -->
    <SolidColorBrush x:Key="BgBrush" Color="#0F141B"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#171E28"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#1E2732"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2A3442"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#3A4658"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E6ECF5"/>
    <SolidColorBrush x:Key="SubBrush" Color="#AEB9C9"/>
    <SolidColorBrush x:Key="MuteBrush" Color="#7E8B9C"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="#4A73FF"/>
    <SolidColorBrush x:Key="PrimaryStrongBrush" Color="#8FA9FF"/>
    <SolidColorBrush x:Key="PrimarySoftBrush" Color="#1A2547"/>
    <SolidColorBrush x:Key="PrimaryLineBrush" Color="#2C3F73"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#3BC9A0"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#0F2A21"/>
    <SolidColorBrush x:Key="SuccessLineBrush" Color="#1E4A3A"/>

    <SolidColorBrush x:Key="WarnBrush" Color="#E0A64A"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#2E2412"/>
    <SolidColorBrush x:Key="WarnLineBrush" Color="#4A3A1C"/>

    <SolidColorBrush x:Key="DangerBrush" Color="#F07070"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#331A1D"/>
    <SolidColorBrush x:Key="DangerLineBrush" Color="#55282C"/>

    <!-- 左导航/标题栏固定深色 chrome，两主题同值 -->
    <SolidColorBrush x:Key="NavBrush" Color="#151B24"/>
    <SolidColorBrush x:Key="Nav2Brush" Color="#10161D"/>
    <SolidColorBrush x:Key="NavTextBrush" Color="#98A5B7"/>
    <SolidColorBrush x:Key="NavHoverBgBrush" Color="#0CFFFFFF"/>
    <SolidColorBrush x:Key="NavActiveBgBrush" Color="#382C5BF6"/>
    <SolidColorBrush x:Key="NavActiveTextBrush" Color="#F1F5FB"/>
    <SolidColorBrush x:Key="NavActiveIcoBrush" Color="#9CB2FF"/>

    <!-- 组件内联色语义化（深色值） -->
    <SolidColorBrush x:Key="GhostHoverBgBrush" Color="#1E2733"/>
    <SolidColorBrush x:Key="GhostHoverBorderBrush" Color="#3A4658"/>
    <SolidColorBrush x:Key="DisabledBgBrush" Color="#1A222D"/>
    <SolidColorBrush x:Key="AccentDisabledBgBrush" Color="#4E5A70"/>
    <SolidColorBrush x:Key="ChipBgBrush" Color="#232C38"/>
    <SolidColorBrush x:Key="LogBoxBgBrush" Color="#1A222D"/>
    <SolidColorBrush x:Key="LogBoxBorderBrush" Color="#2A3543"/>
    <SolidColorBrush x:Key="LogTextBrush" Color="#93A1B3"/>
    <SolidColorBrush x:Key="TermBgBrush" Color="#0D1218"/>
    <SolidColorBrush x:Key="CheckBorderBrush" Color="#3A4658"/>
    <SolidColorBrush x:Key="RowZebraBrush" Color="#141B24"/>

    <!-- 滚动条（轨道透明——深色下不出现系统白色轨道） -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#45536B"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#56657F"/>
    <SolidColorBrush x:Key="ScrollHoverBgBrush" Color="#18FFFFFF"/>
</ResourceDictionary>
